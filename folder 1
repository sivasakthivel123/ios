 1.16 Right-Angled Triangle Pattern
let rows = 5
for i in 1...rows {
    for _ in 1...i {
        print("*", terminator: "")
    }
    print()
}

 1.16 Variation: Skip Even Rows Using Continue
for i in 1...rows {
    if i % 2 == 0 {
        continue
    }
    for _ in 1...i {
        print("*", terminator: "")
    }
    print()
}

 1.17 Palindrome and Armstrong Number
let value = 153
var original = value
var reversed = 0
var temp = value
while temp > 0 {
    reversed = reversed * 10 + temp % 10
    temp /= 10
}
if value == reversed {
    print("Palindrome")
} else {
    print("Not Palindrome")
}
temp = value
var digits = 0
var countTemp = value
repeat {
    digits += 1
    countTemp /= 10
} while countTemp > 0
var armstrongSum = 0
temp = value
while temp > 0 {
    let digit = temp % 10
    var power = 1
    for _ in 1...digits {
        power *= digit
    }
    armstrongSum += power
    temp /= 10
}
if armstrongSum == original {
    print("Armstrong Number")
} else {
    print("Not an Armstrong Number")
}

1.18 BMI Category Using Switch, Ranges and Where
let bmi = 24.5

switch bmi {
case ..<18.5:
    print("Underweight")
case 18.5..<25 where bmi >= 18.5:
    print("Normal")
case 25..<30:
    print("Overweight")
case 30...:
    print("Obese")
default:
    print("Invalid BMI")
}
