1.13 Check Prime and Print Primes from 1 to 50
let number = 17
var isPrime = number > 1
if number > 2 {
    for i in 2..<number {
        if number % i == 0 {
            isPrime = false
            break
        }
    }
}
print(isPrime ? "Prime" : "Not Prime")
for num in 2...50 {
    var prime = true
    if num > 2 {
        for i in 2..<num {
            if num % i == 0 {
                prime = false
                break
            }
        }
    }

    if prime {
        print(num)
    }
}

 1.14 Simple Calculator Using Switch
let x = 20.0
let y = 5.0
let op = "/"
switch op {
case "+":
    print(x + y)
case "-":
    print(x - y)
case "*":
    print(x * y)
case "/":
    if y != 0 {
        print(x / y)
    } else {
        print("Division by zero is not allowed")
    }
default:
    print("Invalid Operator")
}

