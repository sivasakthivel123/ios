 1.17 Palindrome and Armstrong Number
let value = 153
var original = value
var reversed = 0
var temp = value
while temp > 0 {
    reversed = reversed * 10 + temp % 10
    temp /= 10
}
if value == reversed {
    print("Palindrome")
} else {
    print("Not Palindrome")
}
temp = value
var digits = 0
var countTemp = value
repeat {
    digits += 1
    countTemp /= 10
} while countTemp > 0
var armstrongSum = 0
temp = value
while temp > 0 {
    let digit = temp % 10
    var power = 1
    for _ in 1...digits {
        power *= digit
    }
    armstrongSum += power
    temp /= 10
}
if armstrongSum == original {
    print("Armstrong Number")
} else {
    print("Not an Armstrong Number")
}
